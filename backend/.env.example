# Ambiente: development | test | production
ENV=development

# Origens liberadas no CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Postgres do Supabase (Project Settings > Database > Connection string > URI)
# Use o driver asyncpg: postgresql+asyncpg://...
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54322/postgres

# Supabase Auth (Project Settings > API)
SUPABASE_URL=http://localhost:54321
SUPABASE_JWT_SECRET=troque-pelo-jwt-secret-do-projeto

# LLM_PROVIDER=groq usa API OpenAI-compatible; não envie dados reais sem aprovação de privacidade.
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
LLM_TIMEOUT_SECONDS=20
LLM_MAX_OUTPUT_TOKENS=1024
LLM_MAX_TOOL_ROUNDS=3
LLM_MAX_TOOL_CALLS=6
LLM_SESSION_TTL_SECONDS=3600
