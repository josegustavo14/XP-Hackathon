# Ambiente: development | test | production
ENV=development

# Origens liberadas no CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Postgres do Supabase (Project Settings > Database > Connection string > URI)
# Use o driver asyncpg: postgresql+asyncpg://...
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54322/postgres

# Supabase Auth (Project Settings > API)
SUPABASE_URL=http://localhost:54321
SUPABASE_JWT_SECRET=troque-pelo-jwt-secret-do-projeto

# Autenticação demonstrativa local. Não usar AUTH_MODE=mock em produção.
AUTH_MODE=mock
MOCK_AUTH_EMAIL=ana.souza@demo.xpcopilot.dev
MOCK_AUTH_PASSWORD=Demo@2026
MOCK_AUTH_ADVISOR_ID=cfad0fda-72e6-5474-9ec5-eecb3d065425
MOCK_AUTH_ADVISOR_NAME=Ana Souza
LOCAL_JWT_SECRET=troque-por-um-segredo-local-com-ao-menos-32-caracteres
AUTH_TOKEN_EXPIRES_IN=3600
